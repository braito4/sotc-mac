// Original CPU-only borrowed-parameter fixture using the production Task and
// retirement helper. No game input, renderer device or guest pages.
#include <cassert>
#include <coroutine>
#include <deque>
#include <functional>
#include <vector>
#include <cstring>
#include <csignal>
#include <thread>
#include <exception>
#include <cstdlib>
#include <sys/mman.h>
static int Protect(void* p,size_t n,int flags) {
    if(std::getenv("SOTC_TEST_FAIL_PROTECT"))return -1;
    return mprotect(p,n,flags);
}
static int Unmap(void* p,size_t n) {
    if(std::getenv("SOTC_TEST_FAIL_UNMAP"))return -1;
    return munmap(p,n);
}
#define mprotect Protect
#define munmap Unmap
#include "gpu_task_guard.h"
#undef mprotect
#undef munmap
using u8=unsigned char;
#define ASSERT(x) assert(x)
#define UNREACHABLE_MSG(...) std::abort()
namespace BbToggle { constexpr unsigned PipelinedTasks=1; }
namespace Vulkan {
struct Rasterizer {
    std::deque<std::function<void()>> jobs;
    void RunInOrder(void (*callback)(Rasterizer&,const u8*),const void* data,unsigned size,unsigned toggle,bool reads) {
        assert(toggle==BbToggle::PipelinedTasks && !reads);
        std::vector<u8> owned(size);std::memcpy(owned.data(),data,size);
        jobs.emplace_back([this,callback,owned=std::move(owned)]{callback(*this,owned.data());});
    }
    void Drain(){while(!jobs.empty()){auto job=std::move(jobs.front());jobs.pop_front();job();}}
};
}
@TASK@
@RETIREMENT@
static volatile int* borrowed;
__attribute__((noinline)) Task Child(std::array<int,4> parameter) {
    borrowed=&parameter[1];co_yield Task::promise_type::empty{};co_return;
}
static void Fault(int signal,siginfo_t* info,void*) {
    constexpr char message[]="original task fixture: real protected/unmapped CPU access\n";
    write(STDERR_FILENO,message,sizeof(message)-1);
    char line[128];size_t n=0;
    const char* prefix=signal==SIGBUS?"STOP_EXECUTION_FAULT: SIGBUS address=0x":"STOP_EXECUTION_FAULT: SIGSEGV address=0x";
    while(*prefix)line[n++]=*prefix++;
    const uintptr_t address=reinterpret_cast<uintptr_t>(info->si_addr);bool started=false;
    for(int shift=60;shift>=0;shift-=4) {
        const unsigned digit=(address>>shift)&15;
        if(digit || started || !shift){line[n++]="0123456789abcdef"[digit];started=true;}
    }
    line[n++]='\n';write(STDERR_FILENO,line,n);_Exit(128+signal);
}
int main(int argc,char** argv) {
    assert(argc==2);struct sigaction action{};action.sa_sigaction=Fault;action.sa_flags=SA_SIGINFO;
    sigemptyset(&action.sa_mask);assert(!sigaction(SIGSEGV,&action,nullptr));assert(!sigaction(SIGBUS,&action,nullptr));
    const char* mode=argv[1];auto& s=SotcTaskGuard::Get();
    if(!std::strcmp(mode,"budget")) {
        void* first=SotcTaskGuard::Allocate(SotcTaskGuard::Budget);
        void* fallback=SotcTaskGuard::Allocate(32);
        assert(s.mapped==SotcTaskGuard::Budget && s.fallbacks==1);
        SotcTaskGuard::Release(fallback);SotcTaskGuard::Release(first);
        void* next=SotcTaskGuard::Allocate(32);assert(s.mapped<=SotcTaskGuard::Budget);
        SotcTaskGuard::Release(next);
    } else if(!std::strcmp(mode,"churn") || !std::strcmp(mode,"threads") || !std::strcmp(mode,"unmap-failure")) {
        auto loop=[] {for(unsigned i=0;i<400;++i){void* p=SotcTaskGuard::Allocate(32);SotcTaskGuard::Release(p);}};
        if(!std::strcmp(mode,"threads")){std::vector<std::thread> workers;for(unsigned i=0;i<8;++i)workers.emplace_back(loop);for(auto& t:workers)t.join();}
        else loop();
        assert(s.mapped<=SotcTaskGuard::Budget && !s.live && s.count<=SotcTaskGuard::Quarantine);
        if(!std::getenv("SOTC_TEST_FAIL_UNMAP"))assert(s.mapped==s.quarantined && s.count==SotcTaskGuard::Quarantine);
    } else {
        auto task=Child({1,456,3,4});task.handle.resume();assert(!task.handle.done() && *borrowed==456);
        task.handle.resume();assert(task.handle.done());
        Vulkan::Rasterizer recorder;recorder.jobs.emplace_back([]{assert(*borrowed==456);});
        if(!std::strcmp(mode,"immediate") || !std::strcmp(mode,"stale")) {
            task.handle.destroy();recorder.Drain();
            return 99; // A protected stale read must never reach this point.
        }
        RetireCompletedTask(&recorder,task.handle);recorder.Drain();
        assert(!s.live);
    }
    std::printf("PASS: mode=%s mapped=%zu quarantine=%zu fallbacks=%llu\n",mode,s.mapped,s.count,static_cast<unsigned long long>(s.fallbacks));
}
