// Original instruction descriptions and CFG controls; no game data or GPU.
#include <array>
#include <cassert>
#include <cstdint>
#include <cstdio>
#include <string>
#include <vector>
#include "gpu_shader_cfg.h"
#include "shader_recompiler/frontend/control_flow_graph.h"
using namespace Shader::Gcn;
#undef LOG_DEBUG
#define LOG_DEBUG(...) ((void)0)
@RESOLVER@

static GcnInst Inst(Opcode opcode, int immediate=0, u32 length=4) {
    GcnInst i{};i.opcode=opcode;i.length=length;
    i.category=InstCategory::FlowControl;i.control.sopp.simm=static_cast<s16>(immediate);
    return i;
}
static void ResolverControls() {
    std::array<GcnInst,4> a{};
    a[0].opcode=Opcode::S_GETPC_B64;a[0].length=4;a[0].dst[0].code=14;
    a[1].dst[0].code=14;a[1].src_count=2;a[1].src[1].field=OperandField::LiteralConst;
    a[3].opcode=Opcode::S_SETPC_B64;a[3].src[0].code=14;
    std::array<u32,4> pcs{};
    for(u32 base:{0u,0x7ffffffcu,0x80000000u,0xfffffff8u,0xfffffffcu}) {
        pcs[0]=base-4u;
        for(u32 immediate:{0u,1u,4u,0x7fffffffu,0x80000000u,0xffffffffu}) {
            a[1].src[1].code=immediate;
            for(auto op:{Opcode::S_ADD_U32,Opcode::S_SUB_U32}) {
                a[1].opcode=op;
                const std::uint64_t wide=op==Opcode::S_ADD_U32 ?
                    std::uint64_t(base)+immediate : std::uint64_t(base)-immediate;
                const u32 expected=static_cast<u32>(wide)&~3u;
                auto target=ResolveSetPcTarget(a,3,pcs);
                assert(target && *target==expected);
            }
        }
    }
    assert(!ResolveSetPcTarget(a,2,pcs));
    assert(!ResolveSetPcTarget(a,4,pcs));
    assert(!ResolveSetPcTarget(a,3,{}));
}
static void Graph(std::vector<GcnInst> instructions) {
    Common::ObjectPool<Block> pool{64};CFG cfg{pool,instructions};
    assert(cfg.begin()!=cfg.end());
    for(const auto& block:cfg.blocks) {
        assert(block.begin_index<=block.end_index && block.end_index<instructions.size());
        if(block.end_class==EndClass::Branch) assert(block.branch_true);
    }
}
int main(int argc,char** argv) {
    const std::string mode=argc>1?argv[1]:"valid";
    SotcShaderDecode::Scope scope("cfg-fixture",0x5678,5,nullptr);
    if(mode=="resolver") {ResolverControls();return 0;}
    if(mode=="empty") {Graph({});}
    else if(mode=="no-blocks") {Graph({Inst(Opcode::S_NOP)});}
    else if(mode=="outside") {Graph({Inst(Opcode::S_BRANCH,100),Inst(Opcode::S_ENDPGM)});}
    else if(mode=="inside") {Graph({Inst(Opcode::S_BRANCH,1),Inst(Opcode::S_NOP,0,8),Inst(Opcode::S_ENDPGM)});}
    else if(mode=="end-target") {Graph({Inst(Opcode::S_BRANCH,1),Inst(Opcode::S_ENDPGM)});}
    else if(mode=="zero-length") {Graph({Inst(Opcode::S_NOP,0,0),Inst(Opcode::S_ENDPGM)});}
    else if(mode=="misaligned-length") {Graph({Inst(Opcode::S_NOP,0,6),Inst(Opcode::S_ENDPGM)});}
    else if(mode=="overflow-length") {Graph({Inst(Opcode::S_NOP),Inst(Opcode::S_NOP,0,0xfffffffcu)});}
    else if(mode=="unresolved-setpc") {Graph({Inst(Opcode::S_SETPC_B64),Inst(Opcode::S_ENDPGM)});}
    else {
        assert(mode=="valid");ResolverControls();
        Graph({Inst(Opcode::S_ENDPGM)});
        Graph({Inst(Opcode::S_BRANCH,1),Inst(Opcode::S_NOP),Inst(Opcode::S_ENDPGM)});
        Graph({Inst(Opcode::S_NOP),Inst(Opcode::S_BRANCH,-2)});
        Graph({Inst(Opcode::S_CBRANCH_SCC0,0),Inst(Opcode::S_NOP),Inst(Opcode::S_ENDPGM)});
        Graph({Inst(Opcode::S_CBRANCH_EXECZ,1),Inst(Opcode::S_NOP),Inst(Opcode::S_ENDPGM)});
        Graph({Inst(Opcode::S_NOP,0,8),Inst(Opcode::S_ENDPGM)});
        for(u32 immediate:{16u,0xfffffffcu}) {
            auto get=Inst(Opcode::S_GETPC_B64);get.dst[0].code=14;
            auto add=Inst(Opcode::S_ADD_U32,0,8);add.dst[0].code=14;add.src_count=2;
            add.src[1].field=OperandField::LiteralConst;add.src[1].code=immediate;
            auto jump=Inst(Opcode::S_SETPC_B64);jump.src[0].code=14;
            Graph({get,add,Inst(Opcode::S_ADDC_U32),jump,Inst(Opcode::S_ENDPGM)});
        }
        std::puts("PASS: 60 SetPC wrap controls and eight actual valid CFGs; malformed targets remain fatal");
    }
}
