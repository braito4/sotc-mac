#import <Foundation/Foundation.h>
#include <atomic>
#include <cassert>
#include <cstdint>
#include <cstdio>
#include <mutex>
#include <unordered_map>
#include <utility>
#include <vector>
using u64 = std::uint64_t;
using u32 = std::uint32_t;
using VkCommandBuffer = void*;
static unsigned destroyed = 0, commits = 0, ended = 0;

@protocol MTLBuffer <NSObject>
@property(readonly) NSUInteger length;
@end
@protocol MTLCommandBuffer <NSObject>
@property(copy) NSString* label;
@property(readonly) BOOL retainedReferences;
- (void)addCompletedHandler:(void (^)(id<MTLCommandBuffer>))handler;
- (void)commit;
@end

@interface FixtureResource : NSObject <MTLBuffer>
@property NSUInteger length;
@end
@implementation FixtureResource
- (void)dealloc { ++destroyed; }
@end

@interface FixtureCommand : NSObject <MTLCommandBuffer> {
    NSMutableArray* _resources;
    NSMutableArray* _handlers;
}
@property(copy) NSString* label;
@property BOOL retainedReferences;
@property BOOL submitted;
@property BOOL completed;
- (void)encode:(id)resource;
- (void)complete;
@end
static NSMutableArray<FixtureCommand*>* pending;
@implementation FixtureCommand
- (instancetype)init {
    if ((self = [super init])) {
        _resources = [NSMutableArray new];
        _handlers = [NSMutableArray new];
    }
    return self;
}
- (void)encode:(id)resource {
    assert(!_submitted);
    if (_retainedReferences) [_resources addObject:resource];
}
- (void)addCompletedHandler:(void (^)(id<MTLCommandBuffer>))handler {
    assert(!_submitted);
    [_handlers addObject:[handler copy]];
}
- (void)commit {
    assert(!_submitted);
    _submitted = YES;
    ++commits;
    [pending addObject:self];
}
- (void)complete {
    assert(_submitted && !_completed);
    _completed = YES;
    for (void (^handler)(id<MTLCommandBuffer>) in _handlers) handler(self);
    [_handlers removeAllObjects];
    [_resources removeAllObjects];
    [pending removeObjectIdenticalTo:self];
}
@end

@interface FixtureQueue : NSObject
- (id<MTLCommandBuffer>)commandBuffer;
- (id<MTLCommandBuffer>)commandBufferWithUnretainedReferences;
@end
@implementation FixtureQueue
- (id<MTLCommandBuffer>)commandBuffer {
    FixtureCommand* command = [FixtureCommand new];
    command.retainedReferences = YES;
    return command;
}
- (id<MTLCommandBuffer>)commandBufferWithUnretainedReferences {
    FixtureCommand* command = [FixtureCommand new];
    command.retainedReferences = NO;
    return command;
}
@end

namespace SotcGpuTrace {
bool Enabled() { return false; }
struct Journal { u64 Begin(std::uintptr_t) { return 0; } };
Journal& Get() { static Journal journal; return journal; }
}
namespace MetalFrame {
FixtureQueue* queue;
struct Owned {
    id<MTLCommandBuffer> cmd;
    std::vector<id<MTLBuffer>> keep, scratch_used_buffers;
    id<MTLBuffer> scratch;
    u64 scratch_used{}, trace_buffer{}, trace_recording{};
    u32 chunk_draws{}, commands{};
};
std::mutex scratch_pool_mutex;
std::vector<id<MTLBuffer>> scratch_pool;
void EndEncoders(Owned&) { ++ended; }
void CommitCommandBuffer(Owned& o) { [o.cmd commit]; }
@RETURN_SCRATCH@
@CHUNK@
}
namespace Layer {
using MetalFrame::Owned;
FixtureQueue* queue;
std::mutex owned_mutex;
std::unordered_map<VkCommandBuffer, Owned*> owned;
std::atomic<unsigned> owned_count{0};
std::atomic<u64> owned_generation{0};
@OWN@
@COMMIT_OWNED@
}

static FixtureResource* Encode(id<MTLCommandBuffer> command) {
    FixtureResource* resource = [FixtureResource new];
    __weak FixtureResource* observed = resource;
    [(FixtureCommand*)command encode:resource];
    return observed;
}

int main() {
    @autoreleasepool {
        pending = [NSMutableArray new];
        MetalFrame::queue = Layer::queue = [FixtureQueue new];
        const auto key = reinterpret_cast<VkCommandBuffer>(std::uintptr_t{1});
        Layer::OwnBuffer(key);
        auto* o = Layer::owned.at(key);
        unsigned early = 0;
        __weak FixtureResource* first;
        @autoreleasepool { first = Encode(o->cmd); }
        early += first == nil;
        // A completed Vulkan timeline is modelled by dropping external owners;
        // only each Metal batch's explicit resource references may keep it alive.
        FixtureCommand* first_command = (FixtureCommand*)o->cmd;
        MetalFrame::CommitChunk(*o);
        early += first == nil;
        assert(commits == 1 && o->scratch_used == 0 && o->chunk_draws == 0);
        __weak FixtureResource* second;
        @autoreleasepool { second = Encode(o->cmd); }
        early += second == nil;
        FixtureCommand* second_command = (FixtureCommand*)o->cmd;
        MetalFrame::CommitChunk(*o);
        early += second == nil;
        __weak FixtureResource* final;
        __weak FixtureResource* temporary;
        @autoreleasepool {
            final = Encode(o->cmd);
            FixtureResource* resource = [FixtureResource new];
            temporary = resource;
            o->keep.push_back(resource);
        }
        early += final == nil;
        FixtureCommand* final_command = (FixtureCommand*)o->cmd;
        Layer::CommitOwned(1, [&](unsigned) { return key; });
        assert(Layer::owned.empty() && Layer::owned_count == 0 && commits == 3);
        assert(temporary != nil);
        early += final == nil;
        // Later completion does not release an earlier batch's references.
        [second_command complete];
        assert(second == nil && temporary != nil);
        if (first_command.retainedReferences) assert(first != nil && final != nil);
        [first_command complete];
        assert(first == nil && temporary != nil);
        [final_command complete];
        assert(final == nil && temporary == nil && pending.count == 0);
        assert(destroyed == 4 && ended == 3);

        // Reset without submission destroys the old wrapper and its references.
        Layer::OwnBuffer(key);
        __weak FixtureResource* reset;
        @autoreleasepool { reset = Encode(Layer::owned.at(key)->cmd); }
        Layer::OwnBuffer(key);
        assert(reset == nil && pending.count == 0);
        delete Layer::owned.at(key);
        Layer::owned.clear(); Layer::owned_count = 0;

        // Existing scratch-pool ownership is preserved through the real handler.
        MetalFrame::Owned scratch;
        scratch.cmd = [MetalFrame::queue commandBuffer];
        __weak FixtureResource* small;
        @autoreleasepool {
            FixtureResource* pooled = [FixtureResource new];
            pooled.length = 8ull << 20;
            FixtureResource* dropped = [FixtureResource new];
            dropped.length = 4096;
            small = dropped;
            scratch.scratch_used_buffers.push_back(pooled);
            scratch.scratch_used_buffers.push_back(dropped);
        }
        MetalFrame::ReturnScratchWhenDone(scratch);
        assert(scratch.scratch_used_buffers.empty() && small != nil);
        [scratch.cmd commit];
        assert(MetalFrame::scratch_pool.empty());
        [(FixtureCommand*)scratch.cmd complete];
        assert(small == nil && MetalFrame::scratch_pool.size() == 1);
        MetalFrame::scratch_pool.clear();
        assert(pending.count == 0 && destroyed == 7);
        std::printf("early resource releases=%u; initial/split/final, independent completion, reset and scratch controls checked\n", early);
        return early ? 2 : 0;
    }
}
