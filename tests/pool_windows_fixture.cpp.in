// Original geometry and actual range/page-table CPU controls; no GPU or game.
#include <algorithm>
#include <cassert>
#include <cstdint>
#include <cstdio>
#include <memory>
#include <optional>
#include <set>
#include <vector>
#include "gpu_pool_windows.h"
#include "gpu_memory_trace.h"
using u64 = std::uint64_t; using VAddr = u64;
using vkAddress = u64;
namespace vk { using DeviceAddress = vkAddress; }
constexpr u64 G = u64{1} << 30, M = u64{1} << 20;
constexpr unsigned block_shift = 16;
u64 map_base = 0x100000, map_physical = 0, map_bytes = 0;
bool mapping_valid = true;
bool runtime_memory_pool_phys(u64 addr, u64* physical, std::uintptr_t* end) {
    if (!mapping_valid || addr < map_base || addr - map_base >= map_bytes) return false;
    *physical = map_physical + addr - map_base; *end = map_base + map_bytes; return true;
}
struct Buffer {
    u64 size, base;
    std::vector<unsigned char> mapped_data;
    u64 SizeBytes() const { return size; }
    u64 BufferDeviceAddress() const { return base; }
    void Flush(u64 offset, u64 bytes) { assert(offset <= mapped_data.size() && bytes <= mapped_data.size()-offset); }
};
struct Coverage {
    std::set<u64> seen;
    bool Contains(u64 first, u64 end) const {
        for (u64 i=first; i<end; ++i) if (!seen.contains(i)) return false;
        return true;
    }
    template<class F> void ForEachGap(u64 first, u64 end, F f) {
        for (u64 i=first; i<end; ++i) if (!seen.contains(i)) f(i,i+1);
    }
    void Add(std::pair<u64,u64> interval) {
        for (u64 i=interval.first; i<interval.second; ++i) seen.insert(i);
    }
};
struct BufferCache {
    std::vector<std::unique_ptr<Buffer>> pool_windows;
    std::vector<u64> pool_window_starts;
    std::unique_ptr<Buffer> bda_pagetable_buffer;
    Coverage unified_table_blocks;
    struct { u64 CurrentTick() const { return 1; } } scheduler;
    BufferCache(u64 bytes, bool split, bool legacy) {
        for (auto window : SotcPoolWindows::Plan(bytes, split, legacy)) {
            pool_window_starts.push_back(window.start);
            pool_windows.push_back(std::make_unique<Buffer>(Buffer{window.size, 0x1000000000ull+pool_windows.size()*8*G, {}}));
        }
        bda_pagetable_buffer = std::make_unique<Buffer>(Buffer{0,0,std::vector<unsigned char>(1<<20)});
    }
    @WINDOW_METHOD@
    @START_METHOD@
    std::optional<std::pair<const Buffer*,u64>> UnifiedRange(VAddr,u64);
    void UnifiedPageTable(VAddr,u64);
};
@RANGE_METHOD@
@PAGE_METHOD@
u64 Total(const std::vector<SotcPoolWindows::Window>& windows) {
    u64 total=0; for (auto w:windows) total+=w.size; return total;
}
int main() {
    assert(SotcPoolWindows::Plan(0,true,false).empty());
    // Boundary coverage, bounded imports and at most one extra 512 MiB overlap.
    for (u64 bytes=1; bytes<16*G; bytes+=13*M+4096) {
        auto legacy=SotcPoolWindows::Plan(bytes,true,true);
        auto balanced=SotcPoolWindows::Plan(bytes,true,false);
        assert(Total(balanced)<=Total(legacy)+512*M);
        for (auto windows:{legacy,balanced}) {
            assert(windows.front().start==0 && windows.back().start+windows.back().size==bytes);
            for (std::size_t i=0;i<windows.size();++i) {
                assert(windows[i].size<=SotcPoolWindows::Maximum);
                if(i) assert(windows[i].start<=windows[i-1].start+windows[i-1].size);
            }
        }
    }
    for (bool legacy:{false,true}) {
        BufferCache c(6592*M,true,legacy);
        map_physical=2*G+64*M; map_bytes=3*G;
        auto range=c.UnifiedRange(map_base,map_bytes);
        assert(bool(range)==!legacy);
        if(range) {
            assert(range->second==64*M);
            assert(range->first->SizeBytes()>=range->second+map_bytes);
        }
        // Every populated BDA entry resolves to the same physical source byte,
        // including an interior window boundary (not index*the old 3 GiB step).
        const auto* table=reinterpret_cast<const u64*>(c.bda_pagetable_buffer->mapped_data.data());
        for(u64 block=map_base>>block_shift;block<(map_base+map_bytes)>>block_shift;++block) {
            const u64 phys=map_physical+(block<<block_shift)-map_base;
            auto i=c.PoolWindow(phys);
            assert(table[block]==c.pool_windows[i]->base+phys-c.PoolWindowStart(i));
        }
        map_bytes=4*G; assert(!c.UnifiedRange(map_base,map_bytes)); // no truncation
        map_bytes=3*G; assert(!c.UnifiedRange(map_base,map_bytes+1)); // mapping ends
        assert(!c.UnifiedRange(map_base,0));
        mapping_valid=false; assert(!c.UnifiedRange(map_base,64)); mapping_valid=true;
    }
    // Earlier windows remain usable, and unknown/noncontiguous ranges retain fallback.
    BufferCache c(6592*M,true,false);
    for (u64 physical:{0ull,2*G-65536,2*G,5*G-65536,5*G}) {
        map_physical=physical; map_bytes=65536;
        auto range=c.UnifiedRange(map_base,map_bytes);
        assert(range && range->second==physical-c.PoolWindowStart(c.PoolWindow(physical)));
    }
    auto single=SotcPoolWindows::Plan(6592*M,false,false);
    assert(single.size()==1 && single[0].start==0 && single[0].size==6592*M);
    // The old layout remains an exact control: 0/3 GiB origins, not a partial revert.
    BufferCache old(6592*M,true,true);
    assert((old.pool_window_starts==std::vector<u64>{0,3*G}));
    assert(Total(SotcPoolWindows::Plan(6592*M,true,false))==Total(SotcPoolWindows::Plan(6592*M,true,true))+512*M);
    // Tradeoff control: a long range in the shortened prefix can newly require
    // fallback. Preserve it in full; the new geometry is not universally better.
    map_physical=G; map_bytes=2*G;
    assert(old.UnifiedRange(map_base,map_bytes));
    assert(!c.UnifiedRange(map_base,map_bytes));
    map_base=~u64{0}-31; map_physical=0; map_bytes=64;
    assert(!c.UnifiedRange(map_base,64)); // wrapped mapping end rejected before page lookup
    std::puts("PASS: bounded overlapping imports, actual UnifiedRange and BDA origins, mapping/size rejection, legacy/single controls; no GPU");
}
