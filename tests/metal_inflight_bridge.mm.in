// Original Foundation-only command doubles around the production commit wrapper.
#import <Foundation/Foundation.h>
#include <cassert>
#include <future>
#include <thread>
#include <vector>
#include "gpu_metal_inflight.h"
#include "gpu_buffer_chain.h"
@protocol MTLDevice <NSObject>
@property(readonly) NSUInteger currentAllocatedSize;
@property(readonly) NSUInteger recommendedMaxWorkingSetSize;
@end
@protocol MTLCommandBuffer <NSObject>
@property(copy) NSString* label;
@property(readonly) id<MTLDevice> device;
@property(readonly) NSError* error;
@property(readonly) BOOL retainedReferences;
@property(readonly) NSInteger status;
- (void)addScheduledHandler:(void (^)(id<MTLCommandBuffer>))handler;
- (void)addCompletedHandler:(void (^)(id<MTLCommandBuffer>))handler;
- (void)commit;
@end
enum { MTLCommandBufferStatusError = 5 };
#include "gpu_command_failure.h"
#include "gpu_metal_probe.h"
@interface GateDevice : NSObject <MTLDevice>
@end
@implementation GateDevice
- (NSUInteger)currentAllocatedSize { return 1024; }
- (NSUInteger)recommendedMaxWorkingSetSize { return 8192; }
@end
@interface GateCommand : NSObject <MTLCommandBuffer> {
    NSMutableArray* _scheduled;
    NSMutableArray* _completed;
}
@property(copy) NSString* label;
@property(strong) id<MTLDevice> device;
@property(strong) NSError* error;
@property BOOL retainedReferences;
@property NSInteger status;
- (void)schedule;
- (void)finish;
@end
@implementation GateCommand
- (instancetype)init {
    if ((self = [super init])) {
        _scheduled = [NSMutableArray new]; _completed = [NSMutableArray new];
        self.retainedReferences = YES; self.device = [GateDevice new];
    }
    return self;
}
- (void)addScheduledHandler:(void (^)(id<MTLCommandBuffer>))handler {
    assert(self.status == 0); [_scheduled addObject:[handler copy]];
}
- (void)addCompletedHandler:(void (^)(id<MTLCommandBuffer>))handler {
    assert(self.status == 0); [_completed addObject:[handler copy]];
}
- (void)commit { assert(self.status == 0); self.status = 2; }
- (void)schedule {
    assert(self.status == 2); self.status = 3;
    for (void (^handler)(id<MTLCommandBuffer>) in _scheduled) handler(self);
    [_scheduled removeAllObjects];
}
- (void)finish {
    assert(self.status == 2 || self.status == 3);
    self.status = self.error ? 5 : 4;
    for (void (^handler)(id<MTLCommandBuffer>) in _completed) handler(self);
    [_completed removeAllObjects];
}
@end
using u64 = std::uint64_t;
id<MTLDevice> device;
struct Owned {
    id<MTLCommandBuffer> cmd;
    u64 trace_buffer{}, trace_recording{};
};
// Checkpoint behavior is tested independently by encoder_progress_fixture.mm.
namespace SotcEncoderProgress {
template<class T> auto Observe(T&, SotcGpuTrace::MetalProbe probe) { return probe; }
}
// Resource registry sampling is outside this admission/callback fixture.
void ReportMemoryBuffers(bool) {}
@COMMIT@
int main(int argc, char**) {
    @autoreleasepool {
        setenv("SOTC_METAL_INFLIGHT", "8", 1);
        setenv("SOTC_GPU_SUBMIT_TRACE", "1", 1);
        device = [GateDevice new];
        if (argc > 1) {
            GateCommand* command = [GateCommand new];
            Owned o{command};
            CommitCommandBuffer(o);
            command.error = [NSError errorWithDomain:@"synthetic" code:8 userInfo:nil];
            [command finish];
            return 99;
        }
        NSMutableArray<GateCommand*>* commands = [NSMutableArray new];
        for (unsigned i = 0; i < 8; ++i) {
            GateCommand* command = [GateCommand new]; [commands addObject:command];
            Owned o{command}; CommitCommandBuffer(o);
        }
        assert(SotcMetalInflight::Get().Snapshot().active == 8);
        [commands[0] schedule];
        assert(SotcMetalInflight::Get().Snapshot().active == 8);
        std::promise<void> entered;
        auto ready = entered.get_future();
        GateCommand* ninth = [GateCommand new];
        auto writer = std::async(std::launch::async, [&] {
            @autoreleasepool {
                entered.set_value(); Owned o{ninth}; CommitCommandBuffer(o);
            }
        });
        ready.get();
        const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(2);
        while (SotcMetalInflight::Get().Snapshot().waits == 0 &&
               std::chrono::steady_clock::now() < deadline) std::this_thread::yield();
        assert(SotcMetalInflight::Get().Snapshot().waits == 1);
        assert(writer.wait_for(std::chrono::milliseconds(0)) == std::future_status::timeout);
        [commands[5] finish];
        assert(writer.wait_for(std::chrono::seconds(2)) == std::future_status::ready);
        writer.get();
        assert(SotcMetalInflight::Get().Snapshot().active == 8);
        for (unsigned i = 0; i < 8; ++i) if (i != 5) [commands[i] finish];
        [ninth finish];
        const auto s = SotcMetalInflight::Get().Snapshot();
        assert(s.active == 0 && s.peak == 8 && s.acquired == 9 && s.completed == 9 && s.abandoned == 0);
        std::puts("PASS: production commit wrapper/ARC callbacks admit eight; schedule/return "
                  "do not release; out-of-order completion wakes producer; Foundation only");
    }
}
