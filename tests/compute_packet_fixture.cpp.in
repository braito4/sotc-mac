// Original CPU control around the actual production compute packet framing.
#include <algorithm>
#include <array>
#include <cassert>
#include <cstdint>
#include <cstdio>
#include <cstring>
#include <span>
#include <stdexcept>
#include <string>
#include <vector>
#include <sys/mman.h>
#include <unistd.h>
#include "common/bit_field.h"
#include "video_core/amdgpu/pm4_opcodes.h"
using u32 = std::uint32_t;
using namespace AmdGpu;
@HEADERS@
#define UNREACHABLE_MSG(...) throw std::runtime_error("invalid compute packet")
#define ASSERT_MSG(value, ...) do { if (!(value)) UNREACHABLE_MSG(); } while (false)
struct Queue {
    static constexpr std::size_t Capacity=@CAPACITY@;
    u32 read{};
    u32* read_addr{&read};
    u32 ring_size_dw{4096};
    std::array<u32,Capacity> tmp_packet{};
    u32 tmp_dwords{};
    u32 canary{0x1234abcd};
};
struct Decoder {
    Queue queue;
    std::vector<std::vector<u32>> commands;
    static std::span<const u32> NextPacket(std::span<const u32> input, u32 words) {
        assert(words <= input.size()); return input.subspan(words);
    }
    template<bool is_indirect=false> void Decode(std::span<const u32> acb) {
        while (!acb.empty()) {
            @FRAMING@
            const auto words=header->type3.NumWords()+1;
            assert(words >= 2);
            commands.emplace_back(reinterpret_cast<const u32*>(header),
                                  reinterpret_cast<const u32*>(header)+words);
            acb=NextPacket(acb,next_dw_off);
            if constexpr (!is_indirect) {
                *queue.read_addr += next_dw_off;
                *queue.read_addr %= queue.ring_size_dw;
            }
        }
        assert(queue.canary==0x1234abcd);
    }
};
static std::vector<u32> Packet(std::size_t words=6) {
    std::vector<u32> data(words,0xfeed);
    PM4Type3Header header{PM4ItOpcode::SetShReg,u32(words-2)};
    data[0]=header.raw; data[1]=0x20c; data[2]=0x123456; data[3]=0;
    return data;
}
static void ExpectReject(auto&& operation) {
    bool rejected=false;
    try { operation(); } catch (const std::runtime_error&) { rejected=true; }
    assert(rejected);
}
int main(int argc,char** argv) {
    assert(argc==2); const std::string mode=argv[1]; Decoder decoder;
    const auto data=Packet();
    if(mode=="padding") {
        for(u32 padding: {0x80000000u,0xbfff0000u}) {
            decoder.Decode(std::span(&padding,1));assert(decoder.queue.tmp_dwords==0);
        }
        assert(decoder.queue.tmp_dwords==0 && decoder.queue.read==2);
        decoder.Decode(data);assert(decoder.commands==std::vector<std::vector<u32>>{data});
    } else if(mode=="three-parts") {
        decoder.Decode(std::span(data).first(2));
        const auto page=std::size_t(sysconf(_SC_PAGESIZE));
        auto* mapping=static_cast<char*>(mmap(nullptr,page*2,PROT_READ|PROT_WRITE,
                                            MAP_PRIVATE|MAP_ANON,-1,0));
        assert(mapping!=MAP_FAILED); assert(!mprotect(mapping+page,page,PROT_NONE));
        auto* last=reinterpret_cast<u32*>(mapping+page-sizeof(u32)); *last=data[2];
        decoder.Decode(std::span<const u32>(last,1));
        assert(decoder.commands.empty() && decoder.queue.tmp_dwords==3 && decoder.queue.read==3);
        decoder.Decode(std::span(data).subspan(3));
        assert(decoder.commands==std::vector<std::vector<u32>>{data} && decoder.queue.read==data.size());
        assert(!munmap(mapping,page*2));
    } else if(mode=="oversized-split") {
        const auto large=Packet(Queue::Capacity+2);
        ExpectReject([&]{decoder.Decode(std::span(large).first(Queue::Capacity+1));});
        assert(decoder.queue.read==0 && decoder.queue.tmp_dwords==0);
    } else if(mode=="indirect-short") {
        ExpectReject([&]{decoder.Decode<true>(std::span(data).first(2));});
        assert(decoder.queue.read==0 && decoder.queue.tmp_dwords==0);
    } else if(mode=="indirect-isolation") {
        decoder.Decode(std::span(data).first(2));
        auto other=Packet(4);other[2]=0x654321;
        decoder.Decode<true>(other);
        assert(decoder.queue.tmp_dwords==2 && decoder.queue.read==2);
        decoder.Decode(std::span(data).subspan(2));
        assert((decoder.commands==std::vector{other,data}));
    } else if(mode=="ordinary" || mode=="valid") {
        for(std::size_t split=1;split<data.size();++split) {
            Decoder local;local.Decode(std::span(data).first(split));
            local.Decode(std::span(data).subspan(split));
            assert(local.commands==std::vector<std::vector<u32>>{data} && local.queue.read==data.size());
        }
        const auto large=Packet(Queue::Capacity+2);decoder.Decode(large);decoder.Decode<true>(data);
        assert((decoder.commands==std::vector{large,data}));
        assert(decoder.queue.read==large.size());
        auto combined=data;combined.insert(combined.end(),data.begin(),data.end());
        Decoder suffix;suffix.Decode(std::span(combined).first(2));
        suffix.Decode(std::span(combined).subspan(2));
        assert((suffix.commands==std::vector{data,data}) && suffix.queue.read==combined.size());
        if(mode=="ordinary") { std::puts("PASS: ordinary");return 0; }
        Decoder maximum;const auto full=Packet(Queue::Capacity);
        for(auto& word:full) maximum.Decode(std::span(&word,1));
        assert(maximum.commands==std::vector<std::vector<u32>>{full} && maximum.queue.read==full.size());
        Decoder wrap;wrap.queue.read=4094;wrap.Decode(data);assert(wrap.queue.read==4);
    } else if(mode=="invalid-type") {
        const u32 invalid=0;ExpectReject([&]{decoder.Decode(std::span(&invalid,1));});
        assert(decoder.queue.tmp_dwords==0 && decoder.queue.read==0);
    } else assert(false);
    std::printf("PASS: %s\n",mode.c_str());
}
