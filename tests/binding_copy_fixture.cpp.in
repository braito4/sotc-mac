using u64=std::uint64_t; using u32=std::uint32_t; using u8=std::uint8_t; using VAddr=u64;
constexpr u64 operator""_KB(unsigned long long n){return n*1024;}
constexpr u64 MiB=1024*1024, GiB=1024*MiB, LARGE_MIN_GRANULARITY=64_KB;
constexpr bool adapted=@ADAPTED@;
#define BB_SECTION(name)
#define ASSERT_MSG(condition, message) assert(condition)
namespace Common { u64 AlignUp(u64 value,u64 step){return (value+step-1)&~(step-1);} }
namespace SotcVisual { enum Counter {StagingNewBuffers,StagingReuses,StagingOversizeReuses};void Count(Counter){} }
struct Instance {u64 StorageMinAlignment()const{return 16;}u64 NonCoherentAtomSize()const{return 256;}};
struct BackendDevice { static const Instance& From(const Instance& i){return i;} };
namespace VideoCore {
enum class MemoryType {DeviceLocal,HostUncached,HostCached};
struct Buffer {
    u64 size;
    // The capacity is symbolic; payload checks use 64 original synthetic bytes.
    std::vector<u8> mapped_data=std::vector<u8>(64);
    Buffer(const Instance&,int,u64 s,MemoryType,const char*):size(s){}
    u64 SizeBytes()const{return size;}
};
}
using Buffer=VideoCore::Buffer; using MemoryType=VideoCore::MemoryType;
struct Scheduler {u64 current=10,completed=0;u64 CurrentTick()const{return current;}bool IsFree(u64 tick)const{return tick<=completed;}};
struct StagingBufferRef {
    Buffer* buffer{};u64 offset{},size{};u8* mapped{};MemoryType type{};
    void Flush()const{}
};
struct StagingBufferPool {
    struct LargeBuffer {std::unique_ptr<Buffer> buffer;u64 tick,last_used_frame;bool held;u64 used_bytes=0;bool tail_open=false;};
    std::array<std::vector<LargeBuffer>,3> large_caches;
    Instance instance;
    struct Device {struct Caps {u64 storage_min_alignment=16;}; Caps GetCapabilities(){return {};}} device;Scheduler scheduler;u64 frame=0;
    StagingBufferRef RequestLarge(u64,MemoryType,bool,u64 alignment=0);
    StagingBufferRef Request(u64 size,MemoryType type,u64 alignment){return RequestLarge(size,type,false,alignment);}
    void PublishStats()const{}
    u64 Bytes()const {u64 total=0;for(const auto& b:large_caches[1])total+=b.buffer->SizeBytes();return total;}
};
@STAGING_METHODS@

static u64 map_generation=2, map_end=16*GiB, physical=GiB;
static bool mapped=true;
static bool mutate_query=false;
extern "C" const uint64_t* runtime_memory_generation(){return &map_generation;}
extern "C" int runtime_memory_pool_phys(uintptr_t,u64* phys,uintptr_t* end){
    *phys=physical;*end=map_end;
    if(mutate_query)map_generation+=2;
    return mapped;
}
static bool BufferStatsEnabled(){return false;}
struct Memory {
    unsigned copies=0;
    u8 value=0x31;
    std::function<void()> after_copy;
    void CopySparseMemory(VAddr,u8* dest,u64) {
        ++copies;
        for(unsigned i=0;i<64;++i)dest[i]=value^u8(i*3);
        if(after_copy)after_copy();
    }
};
struct BufferCache {
    static constexpr u64 STREAM_THRESHOLD=16_KB;
    StagingBufferPool staging_pool;
    Scheduler& scheduler=staging_pool.scheduler;
    Instance instance;
    struct Device {struct Caps {u64 storage_min_alignment=16;}; Caps GetCapabilities(){return {};}} device;
    Memory backing;Memory* memory=&backing;
    Buffer direct{instance,0,4*GiB,MemoryType::HostUncached,"direct"};
    bool direct_hit=false;
    unsigned range_checks=0,unmap_checks=0;
    std::atomic<bool> unmaps_pending{false};
    std::vector<int> shadows;
    void PrintBufferStats(){} void NoteHotUse(VAddr,u32){} void DropShadows(VAddr,u32){}
    bool UnifiedGuestMemory()const{return true;}
    bool IsRegionGpuModified(VAddr,u32)const{return false;}
    void ProcessUnifiedUnmaps(){++unmap_checks;unmaps_pending.store(false);}
    void NoteWriteTick(VAddr,u32){}
    void SynchronizeMemoryFromImage(const Buffer*,u64,VAddr,u32){}
    std::optional<std::pair<const Buffer*,u64>> UnifiedRange(VAddr,u32){
        ++range_checks;
        if(direct_hit)return std::pair<const Buffer*,u64>{&direct,16};
        return std::nullopt;
    }
    @OBTAIN_DECLARATION@
    std::pair<const Buffer*,u64> UnifiedCopy(VAddr,u64,bool);
};
@OBTAIN_METHOD@
@COPY_METHOD@
using Scope=SotcBindingCopy::Scope<const Buffer*>;
static auto Bind(BufferCache& cache,Scope& scope,u64 slot,u64 address=2*GiB,
                 u32 size=u32(3*GiB-128),bool written=false,bool formatted=false){
    scope.NextBinding(slot);
    return cache.ObtainBuffer(address,size,written,formatted@SCOPE_ARGUMENT@);
}
static void ResetMapping(){map_generation=2;map_end=16*GiB;physical=GiB;mapped=true;mutate_query=false;}
static void CheckPayload(const Buffer* b,u8 value){
    for(unsigned i=0;i<64;++i)assert(b->mapped_data[i]==u8(value^u8(i*3)));
}
int main(){
    ResetMapping();
    BufferCache captured;
    Scope earlier;
    const auto old=Bind(captured,earlier,0,2*GiB+128);
    captured.scheduler.completed=captured.scheduler.current++;
    captured.backing.value=0x62;
    Scope dispatch;
    const auto first=Bind(captured,dispatch,0);
    const auto second=Bind(captured,dispatch,1);
    assert(first.first==old.first); // Real pool method reuses only completed storage.
    assert((first.first==second.first)==adapted);
    assert(captured.backing.copies==(adapted?2u:3u));
    assert(captured.staging_pool.Bytes()==(adapted?3u:6u)*GiB);
    assert(captured.range_checks==3 && captured.unmap_checks==3); // No mapping work skipped.
    CheckPayload(first.first,0x62);CheckPayload(second.first,0x62);
    std::printf("%s duplicate binding: retained=%llu MiB, copies=%u; exact synthetic payload preserved\n",
                adapted?"adapted":"before",(unsigned long long)(captured.staging_pool.Bytes()/MiB),captured.backing.copies);

    // A new draw/dispatch must snapshot fresh data and keep outstanding storage intact.
    Scope next_dispatch;
    captured.backing.value=0x93;
    const auto next=Bind(captured,next_dispatch,0);
    assert(next.first!=first.first && next.first!=second.first);
    CheckPayload(first.first,0x62);CheckPayload(next.first,0x93);
    captured.scheduler.completed=captured.scheduler.current++;
    Scope completed;
    captured.backing.value=0xc4;
    const auto recycled=Bind(captured,completed,0);
    assert(recycled.first==first.first);CheckPayload(recycled.first,0xc4);

    // Changes between slots must force a fresh copy, even for the same address.
    const std::vector<std::function<void(BufferCache&)>> changes={
        [](auto&){map_generation+=2;},[](auto&){map_generation|=1;},
        [](auto&){physical+=4096;},[](auto&){map_end-=4096;},
        [](auto& c){++c.scheduler.current;},[](auto&){mapped=false;},
        [](auto&){map_end=2*GiB+4096;},[](auto&){mutate_query=true;}
    };
    for(const auto& change:changes){
        ResetMapping();BufferCache c;Scope s;
        auto a=Bind(c,s,0);change(c);auto b=Bind(c,s,1);
        assert(c.backing.copies==2 && a.first!=b.first);
    }
    // Different effective ranges, writes, formatted slots, gaps and repeated slots.
    for(unsigned mode=0;mode<6;++mode){
        ResetMapping();BufferCache c;Scope s;auto a=Bind(c,s,0);
        auto b=Bind(c,s,mode==4?2:mode==5?0:1,
                    2*GiB+(mode==0?16:0),u32(3*GiB-128-(mode==1?16:0)),mode==2,mode==3);
        assert(c.backing.copies==2 && a.first!=b.first);
        if(mode==2 || mode==3){Bind(c,s,2);assert(c.backing.copies==3);}
    }
    // A special/direct slot between copies prevents reusing the earlier snapshot.
    ResetMapping();BufferCache separated;Scope separated_scope;
    Bind(separated,separated_scope,0);
    separated.direct_hit=true;Bind(separated,separated_scope,1);
    separated.direct_hit=false;Bind(separated,separated_scope,2);
    assert(separated.backing.copies==2 && separated.range_checks==3);
    // The non-copy path is not memoized or replaced by a snapshot.
    BufferCache direct;Scope direct_scope;direct.direct_hit=true;
    assert(Bind(direct,direct_scope,0).second==16);
    assert(Bind(direct,direct_scope,1).second==16);
    assert(direct.range_checks==2 && direct.backing.copies==0);

    // Mapping/tick changes or a pending unmap during the first copy invalidate it.
    for(unsigned mode=0;mode<3;++mode){
        ResetMapping();BufferCache c;Scope s;
        c.backing.after_copy=[&]{if(mode==0)map_generation+=2;
            if(mode==1)++c.scheduler.current;if(mode==2)c.unmaps_pending.store(true);};
        Bind(c,s,0);c.backing.after_copy={};Bind(c,s,1);
        assert(c.backing.copies==2);
    }
    // Incomplete/missing mappings never create reusable entries.
    for(unsigned mode=0;mode<3;++mode){
        ResetMapping();BufferCache c;Scope s;
        if(mode==0)mapped=false;if(mode==1)map_end=2*GiB+4096;if(mode==2)map_generation|=1;
        Bind(c,s,0);Bind(c,s,1);assert(c.backing.copies==2);
    }
    // Exceptions on a miss cannot leave the former entry valid.
    ResetMapping();BufferCache failing;Scope failing_scope;
    Bind(failing,failing_scope,0);
    failing.backing.after_copy=[]{throw std::runtime_error("synthetic copy failure");};
    try {Bind(failing,failing_scope,1,2*GiB+16);assert(false);} catch(const std::runtime_error&){}
    failing.backing.after_copy={};Bind(failing,failing_scope,1);
    assert(failing.backing.copies==3);
    std::puts("PASS: stage/tick/mapping/range/write/format/adjacency/exception guards and actual pool completion ownership");
    return adapted?0:2;
}
