  "lines": [
    "--- a/gpu/shadps4/video_core/renderer_metal/mtl_frame.mm",
    "+++ b/gpu/shadps4/video_core/renderer_metal/mtl_frame.mm",
    "@@ -12,6 +12,7 @@",
    " #include <tuple>",
    " #include <unordered_map>",
    " #include \"video_core/renderer_metal/mtl_frame.h\"",
    "+#include \"gpu_command_failure.h\"",
    " #include <vulkan/vulkan_metal.h>",
    " #include \"video_core/renderer_metal/mtl_depth_stencil.h\"",
    " #include \"video_core/renderer_metal/mtl_pso_cache.h\"",
    "@@ -719,16 +720,36 @@",
    " }",
    " ",
    " void CommitCommandBuffer(Owned& o) {",
    "-    if (!SotcGpuTrace::Enabled()) { [o.cmd commit]; return; }",
    "-    const auto trace_id = SotcGpuTrace::Get().CommitMetal(o.trace_buffer, o.trace_recording);",
    "-    [o.cmd addScheduledHandler:^(id<MTLCommandBuffer>) {",
    "+    const bool traced = SotcGpuTrace::Enabled();",
    "+    const auto trace_id = traced ? SotcGpuTrace::Get().CommitMetal(o.trace_buffer, o.trace_recording) : 0;",
    "+    const auto trace_buffer = o.trace_buffer;",
    "+    const auto trace_recording = o.trace_recording;",
    "+    if (traced) [o.cmd addScheduledHandler:^(id<MTLCommandBuffer>) {",
    "         SotcGpuTrace::Get().MetalEvent(trace_id, 1);",
    "     }];",
    "+    // Always check native completion, even when the optional journal is disabled.",
    "     [o.cmd addCompletedHandler:^(id<MTLCommandBuffer> command) {",
    "-        SotcGpuTrace::Get().MetalEvent(trace_id, 2, int(command.status), command.error ? command.error.code : 0);",
    "+        NSError* error = command.error;",
    "+        if (traced) SotcGpuTrace::Get().MetalEvent(trace_id, 2, int(command.status), error ? error.code : 0);",
    "+        if (command.status == MTLCommandBufferStatusError) {",
    "+            id<MTLDevice> failed_device = command.device;",
    "+            Sotc::CheckMetalCommandFailure({",
    "+                .failed = true,",
    "+                .status = int(command.status),",
    "+                .code = error ? error.code : 0,",
    "+                .domain = error.domain.UTF8String,",
    "+                .description = error.localizedDescription.UTF8String,",
    "+                .label = command.label.UTF8String,",
    "+                .allocated = failed_device.currentAllocatedSize,",
    "+                .recommended = failed_device.recommendedMaxWorkingSetSize,",
    "+                .chunk = trace_id,",
    "+                .recording = trace_recording,",
    "+                .buffer = trace_buffer,",
    "+            });",
    "+        }",
    "     }];",
    "     [o.cmd commit];",
    "-    SotcGpuTrace::Get().MetalEvent(trace_id, 0);",
    "+    if (traced) SotcGpuTrace::Get().MetalEvent(trace_id, 0);",
    " }",
    " ",
    " void CommitChunk(Owned& o) {"
  ]
}
