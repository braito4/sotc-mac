    "+// SotC: bounded optional readback of the game image, never the user's desktop.",
    "+void CaptureVisualFrame(const Instance& instance, Scheduler& scheduler, vk::CommandBuffer cmdbuf,",
    "+                        const Frame* frame, vk::Format format, const SotcVisual::Frame& evidence) {",
    "+    const bool bgra = format == vk::Format::eB8G8R8A8Unorm || format == vk::Format::eB8G8R8A8Srgb;",
    "+    const bool rgba = format == vk::Format::eR8G8B8A8Unorm || format == vk::Format::eR8G8B8A8Srgb;",
    "+    auto ticket = SotcVisual::Get().ReserveCapture(evidence, bgra || rgba);",
    "+    if (!ticket) return;",
    "+    const VkDeviceSize size = VkDeviceSize(frame->width) * frame->height * 4;",
    "+    const VkBufferCreateInfo buffer_ci{.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,",
    "+                                       .size = size, .usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT};",
    "+    const VmaAllocationCreateInfo alloc_ci{",
    "+        .flags = VMA_ALLOCATION_CREATE_DEDICATED_MEMORY_BIT | VMA_ALLOCATION_CREATE_MAPPED_BIT |",
    "+                 VMA_ALLOCATION_CREATE_HOST_ACCESS_RANDOM_BIT,",
    "+        .usage = VMA_MEMORY_USAGE_AUTO_PREFER_HOST,",
    "+        .requiredFlags = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT};",
    "+    VkBuffer buffer{}; VmaAllocation allocation{}; VmaAllocationInfo mapping{};",
    "+    if (vmaCreateBuffer(instance.GetAllocator(), &buffer_ci, &alloc_ci, &buffer, &allocation,",
    "+                        &mapping) != VK_SUCCESS) {",
    "+        SotcVisual::Get().CaptureFailed(*ticket, \"allocation_failed\");",
    "+        return;",
    "+    }",
    "+    if (!mapping.pMappedData) {",
    "+        vmaDestroyBuffer(instance.GetAllocator(), buffer, allocation);",
    "+        SotcVisual::Get().CaptureFailed(*ticket, \"mapping_unavailable\");",
    "+        return;",
    "+    }",
    "+    const vk::BufferImageCopy region{.imageSubresource = {vk::ImageAspectFlagBits::eColor, 0, 0, 1},",
    "+                                     .imageExtent = {frame->width, frame->height, 1}};",
    "+    cmdbuf.copyImageToBuffer(frame->image, vk::ImageLayout::eTransferSrcOptimal, buffer, region);",
    "+    const vk::MemoryBarrier visible{.srcAccessMask = vk::AccessFlagBits::eTransferWrite,",
    "+                                    .dstAccessMask = vk::AccessFlagBits::eHostRead};",
    "+    cmdbuf.pipelineBarrier(vk::PipelineStageFlagBits::eTransfer, vk::PipelineStageFlagBits::eHost,",
    "+                           {}, visible, {}, {});",
    "+    scheduler.DeferPriorityOperation([allocator = instance.GetAllocator(), buffer, allocation,",
    "+                                      mapping, size, bgra, ticket = *ticket] {",
    "+        if (vmaInvalidateAllocation(allocator, allocation, 0, VK_WHOLE_SIZE) == VK_SUCCESS) {",
    "+            SotcVisual::Get().CompleteCapture(ticket,",
    "+                {static_cast<const std::uint8_t*>(mapping.pMappedData), std::size_t(size)}, bgra);",
    "+        } else SotcVisual::Get().CaptureFailed(ticket, \"invalidate_failed\");",
    "+        vmaDestroyBuffer(allocator, buffer, allocation);",
    "+    });",
    "+}",
