    "+// Completed decoding is not completion of the queued recording consumers.",
    "+// Copy the handle address into an ordered packet, preserving frame parameters",
    "+// (including SubmittedCopy ownership) until every earlier packet was consumed.",
    "+// This retires CPU frames only; GPU resources retain their own completion rules.",
    "+static void RetireCompletedTask(Vulkan::Rasterizer* rasterizer, std::coroutine_handle<> task) {",
    "+    ASSERT(task && task.done());",
    "+    if (!rasterizer) {",
    "+        task.destroy();",
    "+        return;",
    "+    }",
    "+    void* frame = task.address();",
    "+    rasterizer->RunInOrder(",
    "+        [](Vulkan::Rasterizer&, const u8* data) {",
    "+            void* completed_frame;",
    "+            std::memcpy(&completed_frame, data, sizeof(completed_frame));",
    "+            std::coroutine_handle<>::from_address(completed_frame).destroy();",
    "+        },",
    "+        &frame, sizeof(frame), BbToggle::PipelinedTasks, false);",
    " }",
    " ",
