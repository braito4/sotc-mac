        "@@ -172,7 +172,22 @@",
        "     std::string last_error;       ///< guarded by flush_mutex: logged once per distinct error",
        " };",
        " ",
        "-constexpr auto kWriteInterval = std::chrono::seconds{10};",
        "+// SotC: rebuild less often during play; explicit Flush/shutdown still writes immediately.",
        "+// Reading the existing archive and atomic replacement remain unchanged.",
        "+static std::chrono::seconds SotcArchiveWriteInterval() {",
        "+    unsigned seconds = 0;",
        "+    const char* value = std::getenv(\"SOTC_ARCHIVE_WRITE_SECONDS\");",
        "+    bool valid = value && *value;",
        "+    if (valid) {",
        "+        for (const char* p = value; *p; ++p) {",
        "+            if (*p < '0' || *p > '9' || seconds > 600) { valid = false; break; }",
        "+            seconds = seconds * 10 + unsigned(*p - '0');",
        "+        }",
        "+    }",
        "+    if (!valid || seconds < 10 || seconds > 600) seconds = 10;",
        "+    return std::chrono::seconds{seconds};",
        "+}",
        "+const auto kWriteInterval = SotcArchiveWriteInterval();",
        " ",
        " RenderPipeline::~RenderPipeline() {",
        "     // Balance the +1 of __bridge_retained; ARC releases at the end of the scope.",
        "@@ -267,6 +282,8 @@",
