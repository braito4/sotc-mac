    "+        upload_batch_budget.Reset();",
    "+        if (SotcUploadBatch::Trace()) std::fprintf(stderr, \"Upload batch trial: completed tick=%llu next_tick=%llu\\n\",",
    "+                     static_cast<unsigned long long>(tick),",
