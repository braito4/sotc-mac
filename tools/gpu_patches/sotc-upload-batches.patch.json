    "+        upload_batch_budget.CompletedUpload(scheduler.CurrentTick(), dst->info.guest_size)) {",
    "+        const auto tick = scheduler.CurrentTick();",
    "+        FlushBarriers();",
    "+        if (SotcUploadBatch::Trace()) std::fprintf(stderr, \"Upload batch trial: submit_wait tick=%llu budget_mib=64; completed image boundary\\n\",",
