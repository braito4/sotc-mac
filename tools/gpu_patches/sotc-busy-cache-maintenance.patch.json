    "+void Rasterizer::MaintainCaches(bool force) {",
    "+    const auto now = std::chrono::duration_cast<std::chrono::nanoseconds>(",
    "+                         std::chrono::steady_clock::now().time_since_epoch()).count();",
    "+    constexpr s64 interval_ns = 250'000'000;",
    "+    if (!force && now - last_cache_maintenance_ns < interval_ns) {",
    "+        return;",
    "+    }",
    "+    // A completed frame can be followed immediately by new submissions. Waiting for",
    "+    // every queue to become empty can starve collection and stale-proxy retirement.",
    "+    // Run on the existing ordered renderer path, with prepared draws drained. Resource",
    "+    // owners still defer destruction to real GPU completion past the next submission.",
    "+    DrainDrawPipe();",
    "+    last_cache_maintenance_ns = now;",
    "     texture_cache.ProcessDownloadImages();",
    "     texture_cache.RunGarbageCollector();",
    "     scene_targets->CleanupStaleEntries();",
    "-    runtime.TickFrame();",
    "     BbMetalResidency::ReleaseRetired();",
    " }",
