    "+void TraceSubmission(const Scheduler* scheduler, vk::Semaphore timeline, u64 tick,",
    "+                     const SubmitInfo& info, std::span<const vk::CommandBuffer> buffers) {",
    "+    if (!SotcGpuTrace::Enabled()) return;",
    "+    SotcGpuTrace::Submission submission{};",
    "+    submission.scheduler = reinterpret_cast<std::uintptr_t>(scheduler);",
    "+    submission.timeline = reinterpret_cast<std::uintptr_t>(static_cast<VkSemaphore>(timeline));",
    "+    submission.tick = tick;",
    "+    submission.wait_count = info.num_wait_semas;",
    "+    submission.signal_count = info.num_signal_semas;",
    "+    for (u32 i = 0; i < info.num_wait_semas && i < 4; ++i)",
    "+        submission.waits[i] = {reinterpret_cast<std::uintptr_t>(static_cast<VkSemaphore>(info.wait_semas[i])), info.wait_ticks[i]};",
    "+    for (u32 i = 0; i < info.num_signal_semas && i < 4; ++i)",
    "+        submission.signals[i] = {reinterpret_cast<std::uintptr_t>(static_cast<VkSemaphore>(info.signal_semas[i])), info.signal_ticks[i]};",
    "+    std::vector<SotcGpuTrace::Key> keys;",
