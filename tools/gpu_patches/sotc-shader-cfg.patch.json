    "         auto it = blocks.find(address, Compare{});",
    "-        ASSERT_MSG(it != blocks.cend() && it->begin == address);",
    "+        if (it == blocks.cend() || it->begin != address) {",
    "+            SotcShaderCfg::Fail(reason, source, address, index_to_pc.back(), inst_list.size());",
    "+        }",
    "         return &*it;",
    "     };",
    " ",
    "@@ -322,7 +338,7 @@",
