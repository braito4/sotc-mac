    " static std::optional<u32> ResolveSetPcTarget(std::span<const GcnInst> list, u32 setpc_index,",
    "                                              std::span<const u32> pc_map) {",
    "-    if (setpc_index < 3) {",
    "+    if (setpc_index < 3 || setpc_index >= list.size() || setpc_index - 3 >= pc_map.size()) {",
    "         return std::nullopt;",
    "     }",
    " ",
    "@@ -91,13 +92,11 @@",
