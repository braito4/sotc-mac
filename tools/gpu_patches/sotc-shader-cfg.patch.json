    "+        if (!inst.length || (inst.length & 3u) || inst.length > UINT32_MAX - pc) {",
    "+            SotcShaderCfg::Fail(\"invalid_instruction_length\", pc, inst.length, pc, inst_list.size());",
    "+        }",
    "         if (inst.IsUnconditionalBranch()) {",
    "             u32 target = inst.BranchTarget(pc);",
