    "                 } else {",
    "-                    ASSERT_MSG(",
    "-                        false,",
    "-                        \"S_SETPC_B64 without a resolvable offset at PC {:#x} (Index {}): Involved \"",
    "-                        \"instructions not recognized or invalid pattern\",",
    "-                        pc, i);",
    "+                    SotcShaderCfg::Fail(\"unresolved_setpc\", pc, 0, 0, inst_list.size());",
    "                 }",
    "             }",
    "             AddLabel(target);",
    "@@ -157,6 +161,16 @@",
    " ",
    "     // Sort labels to make sure block insertion is correct.",
    "     std::ranges::sort(labels);",
    "+    // A block boundary must name an actual decoded instruction (or the end",
    "+    // sentinel), never a literal/second dword or bytes beyond the supplied code.",
    "+    for (const u32 label : labels) {",
    "+        if (label > pc) {",
    "+            SotcShaderCfg::Fail(\"target_outside_program\", 0, label, pc, inst_list.size());",
    "+        }",
    "+        if (!std::binary_search(index_to_pc.begin(), index_to_pc.end(), label)) {",
    "+            SotcShaderCfg::Fail(\"target_inside_instruction\", 0, label, pc, inst_list.size());",
    "+        }",
    "+    }",
    " }",
