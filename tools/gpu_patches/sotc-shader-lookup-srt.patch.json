    " static bool ComputeOffset(SrtProgram& p, PassInfo& pass_info, const IR::Value& off_dw) {",
    "     auto inst = off_dw.Inst();",
    "+    // SotC: only a branch-independent Phi has a CPU-side SRT offset. Compare",
    "+    // emitted offset programs, never choose an incoming edge or substitute zero.",
    "+    // Bound nested/cyclic SSA before recursively inspecting incoming values.",
    "+    static thread_local std::vector<const IR::Inst*> active_offsets;",
    "+    static thread_local size_t remaining_offsets;",
    "+    if (active_offsets.empty()) remaining_offsets = 4096;",
    "+    if (!remaining_offsets || active_offsets.size() >= 256 ||",
    "+        std::ranges::find(active_offsets, inst) != active_offsets.end()) {",
    "+        return false;",
    "+    }",
    "+    --remaining_offsets;",
    "+    active_offsets.push_back(inst);",
    "+    struct OffsetGuard {",
    "+        std::vector<const IR::Inst*>& active;",
    "+        ~OffsetGuard() { active.pop_back(); }",
    "+    } guard{active_offsets};",
    "     switch (inst->GetOpcode()) {",
    "+    case IR::Opcode::Phi: {",
    "+        if (inst->NumArgs() == 0) return false;",
    "+        SrtProgram common;",
    "+        for (size_t i = 0; i < inst->NumArgs(); ++i) {",
    "+            SrtProgram incoming;",
    "+            if (!EmitOperand(incoming, pass_info, inst->Arg(i))) return false;",
    "+            if (i == 0) common = std::move(incoming);",
    "+            else if (incoming != common) return false;",
    "+        }",
    "+        p.insert(p.end(), common.begin(), common.end());",
    "+        return true;",
    "+    }",
    "     case IR::Opcode::GetUserData:",
    "         p.insert(p.end(), {OpUserData, static_cast<u32>(inst->Arg(0).ScalarReg())});",
    "         return true;",
