    "+                std::memcpy(queue.tmp_packet.data() + queue.tmp_dwords, acb.data(),",
    "+                            next_dw_off * sizeof(u32));",
    "+                queue.tmp_dwords += next_dw_off;",
    "+                if (queue.tmp_dwords < total) {",
    "+                    *queue.read_addr += next_dw_off;",
    "+                    *queue.read_addr %= queue.ring_size_dw;",
    "+                    break;",
    "+                }",
    "+                queue.tmp_dwords = 0;",
    "+            } else {",
    "+                next_dw_off = packet_words(header);",
    "+                if (next_dw_off > acb.size()) [[unlikely]] {",
    "+                    if (next_dw_off > queue.tmp_packet.size()) {",
    "+                        UNREACHABLE_MSG(\"Split compute PM4 exceeds buffer capacity\");",
    "+                    }",
    "+                    std::memcpy(queue.tmp_packet.data(), acb.data(), acb.size_bytes());",
    "+                    queue.tmp_dwords = static_cast<u32>(acb.size());",
    "+                    *queue.read_addr += queue.tmp_dwords;",
    "+                    *queue.read_addr %= queue.ring_size_dw;",
    "+                    break;",
    "+                }",
    "+            }",
    "+        } else {",
    "+            next_dw_off = packet_words(header);",
    "+            if (next_dw_off > acb.size()) {",
    "+                UNREACHABLE_MSG(\"Truncated compute indirect PM4 buffer\");",
    "+            }",
