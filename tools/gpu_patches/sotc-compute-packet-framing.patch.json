    "-            break;",
    "+        const auto packet_words = [](const PM4Header* packet) -> u32 {",
    "+            // Type-2 padding is exactly one word; its count bits are not a size.",
    "+            if (packet->type == 2) return 1;",
    "+            if (packet->type != 3 || !packet->type3.NumWords()) {",
    "+                UNREACHABLE_MSG(\"Invalid compute PM4 header {:#x}\", packet->raw);",
    "+            }",
    "+            return packet->type3.NumWords() + 1;",
    "+        };",
    "+        u32 next_dw_off{};",
    "+        if constexpr (!is_indirect) {",
    "+            // Only the ring can continue in another submission. Nested indirect",
    "+            // buffers are complete extents and must not consume this queue state.",
    "+            if (queue.tmp_dwords > 0) [[unlikely]] {",
    "+                header = reinterpret_cast<const PM4Header*>(queue.tmp_packet.data());",
    "+                const auto total = packet_words(header);",
    "+                if (total > queue.tmp_packet.size() || queue.tmp_dwords >= total) {",
    "+                    UNREACHABLE_MSG(\"Invalid buffered compute PM4 extent\");",
    "+                }",
    "+                next_dw_off = static_cast<u32>(",
