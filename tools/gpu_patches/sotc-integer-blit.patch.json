{
  "lines": [
    "--- a/gpu/shadps4/video_core/renderer_metal/mtl_frame.mm",
    "+++ b/gpu/shadps4/video_core/renderer_metal/mtl_frame.mm",
    "@@ -1685,10 +1685,57 @@",
    " }",
    " ",
    " namespace {",
    "-id<MTLLibrary> blit_library;",
    "+id<MTLLibrary> blit_library, blit_integer_library;",
    " id<MTLSamplerState> blit_linear, blit_nearest;",
    " std::vector<std::pair<MTLPixelFormat, id<MTLRenderPipelineState>>> blit_pipelines;",
    " std::mutex blit_mutex;",
    "+",
    "+// SotC: integer copies must preserve integer texels, including values above 2^24.",
    "+// Keep this first implementation limited to same-format, nearest 2D blits.",
    "+// Other integer shapes/conversions fail explicitly; never use a float fallback.",
    "+u32 BlitIntegerKind(MTLPixelFormat format) {",
    "+    switch (format) {",
    "+    case MTLPixelFormatR8Uint: case MTLPixelFormatR16Uint: case MTLPixelFormatR32Uint:",
    "+    case MTLPixelFormatRG8Uint: case MTLPixelFormatRG16Uint: case MTLPixelFormatRG32Uint:",
    "+    case MTLPixelFormatRGBA8Uint: case MTLPixelFormatRGBA16Uint: case MTLPixelFormatRGBA32Uint:",
    "+    case MTLPixelFormatRGB10A2Uint:",
    "+        return 1;",
    "+    case MTLPixelFormatR8Sint: case MTLPixelFormatR16Sint: case MTLPixelFormatR32Sint:",
    "+    case MTLPixelFormatRG8Sint: case MTLPixelFormatRG16Sint: case MTLPixelFormatRG32Sint:",
    "+    case MTLPixelFormatRGBA8Sint: case MTLPixelFormatRGBA16Sint: case MTLPixelFormatRGBA32Sint:",
    "+        return 2;",
    "+    default:",
    "+        return 0;",
    "+    }",
    "+}",
    "+",
    "+const char* BlitFragmentName(MTLPixelFormat format) {",
    "+    switch (BlitIntegerKind(format)) {",
    "+    case 1: return \"blit_uint_fs\";",
    "+    case 2: return \"blit_sint_fs\";",
    "+    default: return Metal::VkToMtl::IsDepthPixelFormat(u32(format)) ? \"blit_depth_fs\" : \"blit_fs\";",
    "+    }",
    "+}",
    "+",
    "+bool IntegerBlitSupported(MTLPixelFormat src, MTLPixelFormat dst, MTLTextureType src_type,",
    "+                          MTLTextureType dst_type, NSUInteger src_samples,",
    "+                          NSUInteger dst_samples, VkFilter filter) {",
    "+    return src == dst && BlitIntegerKind(src) != 0 && filter == VK_FILTER_NEAREST &&",
    "+           src_type == MTLTextureType2D && dst_type == MTLTextureType2D &&",
    "+           src_samples == 1 && dst_samples == 1;",
    "+}",
    "+",
    "+bool IntegerBlitRegionSupported(const VkImageBlit& b, NSUInteger src_levels,",
    "+                                NSUInteger dst_levels) {",
    "+    return b.srcSubresource.mipLevel < src_levels && b.dstSubresource.mipLevel < dst_levels &&",
    "+           b.srcSubresource.mipLevel < 32 && b.dstSubresource.mipLevel < 32 &&",
    "+           b.srcSubresource.baseArrayLayer == 0 && b.dstSubresource.baseArrayLayer == 0 &&",
    "+           b.srcSubresource.layerCount == 1 && b.dstSubresource.layerCount == 1 &&",
    "+           b.srcSubresource.aspectMask == VK_IMAGE_ASPECT_COLOR_BIT &&",
    "+           b.dstSubresource.aspectMask == VK_IMAGE_ASPECT_COLOR_BIT &&",
    "+           b.srcOffsets[0].z == 0 && b.srcOffsets[1].z == 1 &&",
    "+           b.dstOffsets[0].z == 0 && b.dstOffsets[1].z == 1;",
    "+}",
    " ",
    " /// Fullscreen-triangle copy of a source rectangle (normalized) into the viewport, for",
    " /// vkCmdBlitImage: Metal's blit encoder neither scales nor filters.",
    "@@ -1699,8 +1746,10 @@",
    "             return state;",
    "         }",
    "     }",
    "+    // An integer shader failure must not invalidate the existing float/depth library.",
    "+    id<MTLLibrary> __strong& library = BlitIntegerKind(format) ? blit_integer_library : blit_library;",
    "     NSError* error = nil;",
    "-    if (!blit_library) {",
    "+    if (!library) {",
    "         NSString* source =",
    "             @\"#include <metal_stdlib>\\n\"",
    "              \"using namespace metal;\\n\"",
    "@@ -1716,8 +1765,21 @@",
    "              \"fragment D blit_depth_fs(V in [[stage_in]], depth2d<float> tex [[texture(0)]],\\n\"",
    "              \"                         sampler s [[sampler(0)]]) { D d; d.depth = tex.sample(s, in.uv);\\n\"",
    "              \"                         return d; }\\n\";",
    "-        blit_library = [device newLibraryWithSource:source options:nil error:&error];",
    "-        if (!blit_library) {",
    "+        if (BlitIntegerKind(format)) {",
    "+            source = [source stringByAppendingString:",
    "+                @\"fragment uint4 blit_uint_fs(V in [[stage_in]], texture2d<uint, access::read> tex [[texture(0)]],\\n\"",
    "+             \"                            constant uint& src_level [[buffer(0)]]) {\\n\"",
    "+             \"    uint2 size = uint2(tex.get_width(src_level), tex.get_height(src_level));\\n\"",
    "+             \"    int2 p = clamp(int2(floor(in.uv * float2(size))), int2(0), int2(size) - 1);\\n\"",
    "+             \"    return tex.read(uint2(p), src_level); }\\n\"",
    "+             \"fragment int4 blit_sint_fs(V in [[stage_in]], texture2d<int, access::read> tex [[texture(0)]],\\n\"",
    "+             \"                           constant uint& src_level [[buffer(0)]]) {\\n\"",
    "+             \"    uint2 size = uint2(tex.get_width(src_level), tex.get_height(src_level));\\n\"",
    "+             \"    int2 p = clamp(int2(floor(in.uv * float2(size))), int2(0), int2(size) - 1);\\n\"",
    "+             \"    return tex.read(uint2(p), src_level); }\\n\"];",
    "+        }",
    "+        library = [device newLibraryWithSource:source options:nil error:&error];",
    "+        if (!library) {",
    "             std::printf(\"Metal frame: blit shader: %s\\n\", error.localizedDescription.UTF8String);",
    "             return nil;",
    "         }",
    "@@ -1729,10 +1791,11 @@",
    "         blit_nearest = [device newSamplerStateWithDescriptor:sd];",
    "     }",
    "     MTLRenderPipelineDescriptor* d = [MTLRenderPipelineDescriptor new];",
    "-    d.vertexFunction = [blit_library newFunctionWithName:@\"blit_vs\"];",
    "+    d.vertexFunction = [library newFunctionWithName:@\"blit_vs\"];",
    "     // Depth images (the upscaler scales depth with vkCmdBlitImage) write depth, not color.",
    "     const bool is_depth = Metal::VkToMtl::IsDepthPixelFormat(u32(format));",
    "-    d.fragmentFunction = [blit_library newFunctionWithName:is_depth ? @\"blit_depth_fs\" : @\"blit_fs\"];",
    "+    d.fragmentFunction = [library newFunctionWithName:",
    "+        [NSString stringWithUTF8String:BlitFragmentName(format)]];",
    "     if (is_depth) {",
    "         d.depthAttachmentPixelFormat = format;",
    "         if (Metal::VkToMtl::HasStencilPixelFormat(u32(format))) {",
    "@@ -1755,8 +1818,27 @@",
    "                const VkImageBlit* regions, VkFilter filter) {",
    "     id<MTLTexture> src = TextureOfImage(src_image);",
    "     id<MTLTexture> dst = TextureOfImage(dst_image);",
    "-    id<MTLRenderPipelineState> pipeline = dst ? BlitPipeline(dst.pixelFormat) : nil;",
    "-    if (!src || !dst || !pipeline) {",
    "+    if (!src || !dst) {",
    "+        return;",
    "+    }",
    "+    const bool integer = BlitIntegerKind(src.pixelFormat) || BlitIntegerKind(dst.pixelFormat);",
    "+    if (integer) {",
    "+        if (!IntegerBlitSupported(src.pixelFormat, dst.pixelFormat, src.textureType, dst.textureType,",
    "+                                  src.sampleCount, dst.sampleCount, filter)) {",
    "+            std::printf(\"Metal frame: unsupported integer blit formats/types/filter (%lu -> %lu)\\n\",",
    "+                        (unsigned long)src.pixelFormat, (unsigned long)dst.pixelFormat);",
    "+            return;",
    "+        }",
    "+        // Validate the entire batch before recording any copies.",
    "+        for (u32 r = 0; r < count; ++r) {",
    "+            if (!IntegerBlitRegionSupported(regions[r], src.mipmapLevelCount, dst.mipmapLevelCount)) {",
    "+                std::printf(\"Metal frame: unsupported integer blit subresource at region %u\\n\", r);",
    "+                return;",
    "+            }",
    "+        }",
    "+    }",
    "+    id<MTLRenderPipelineState> pipeline = BlitPipeline(dst.pixelFormat);",
    "+    if (!pipeline) {",
    "         return;",
    "     }",
    "     EndEncoders(o);",
    "@@ -1812,8 +1894,14 @@",
    "                                        0.0, 1.0}];",
    "         [enc setVertexBytes:uv length:sizeof uv atIndex:0];",
    "         [enc setFragmentTexture:src atIndex:0];",
    "-        [enc setFragmentSamplerState:filter == VK_FILTER_NEAREST ? blit_nearest : blit_linear",
    "-                             atIndex:0];",
    "+        if (integer) {",
    "+            // Explicit mip selection and read() avoid filtering or float conversion of texels.",
    "+            const u32 src_level = b.srcSubresource.mipLevel;",
    "+            [enc setFragmentBytes:&src_level length:sizeof src_level atIndex:0];",
    "+        } else {",
    "+            [enc setFragmentSamplerState:filter == VK_FILTER_NEAREST ? blit_nearest : blit_linear",
    "+                                 atIndex:0];",
    "+        }",
    "         [enc drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];",
    "         [enc endEncoding];",
    "     }"
  ]
